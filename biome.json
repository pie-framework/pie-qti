{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"assist": {
		"enabled": false
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*",
			"!**/playwright-report",
			"!**/test-results",
			"!**/.svelte-kit",
			"!**/dist",
			"!**/tests/**/fixtures"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"correctness": {
				"recommended": true,
				"noUnusedVariables": "off",
				"noUnusedImports": "off",
				"noUnusedPrivateClassMembers": "off"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"image-size": "Import from packages/to-pie/src/utils/image-utils.ts instead. It calls disableTypes() to refuse the ICNS, HEIF and JXL parsers, whose unfixed advisories (GHSA-w3rx-r6r6-pgpr, GHSA-5p2g-fcmc-qvqq) loop forever on partner-supplied bytes. A direct import bypasses that guard."
						}
					}
				}
			},
			"suspicious": {
				"recommended": true,
				"noExplicitAny": "off",
				"noImplicitAnyLet": "off",
				"noAssignInExpressions": "off",
				"useIterableCallbackReturn": "off"
			}
		}
	},
	"formatter": {
		"enabled": false
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["packages/to-pie/src/utils/image-utils.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}
