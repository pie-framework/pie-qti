{
  "name": "@pie-qti/app-demo",
  "version": "0.1.0",
  "description": "QTI (2.x and 3.0) Player Example & Demo Application",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf build .svelte-kit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "echo 'E2E tests run separately via test:e2e'",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:cross-browser": "playwright test --project=webkit --project=firefox",
    "test:a11y": "playwright test --project=chromium tests/playwright/component-fixtures-a11y.pw.ts tests/playwright/assessment-a11y-behavior.pw.ts tests/playwright/qti3-stage5-a11y.pw.ts tests/playwright/a11y-regression.pw.ts",
    "test:a11y:ui": "playwright test tests/playwright/component-fixtures-a11y.pw.ts tests/playwright/assessment-a11y-behavior.pw.ts tests/playwright/qti3-stage5-a11y.pw.ts tests/playwright/a11y-regression.pw.ts --ui"
  },
  "dependencies": {
    "@acme/likert-scale-plugin": "workspace:*",
    "@pie-players/tts-server-polly": "1.0.0-beta.9",
    "@pie-qti/assessment-player": "workspace:*",
    "@pie-qti/default-components": "workspace:*",
    "@pie-qti/i18n": "workspace:*",
    "@pie-qti/ims-cp-browser": "workspace:*",
    "@pie-qti/ims-cp-core": "workspace:*",
    "@pie-qti/item-player": "workspace:*",
    "@pie-qti/logger": "workspace:*",
    "@pie-qti/pie-to-qti2": "workspace:*",
    "@pie-qti/player-elements": "workspace:*",
    "@pie-qti/qti-common": "workspace:*",
    "@pie-qti/section-player": "workspace:*",
    "@pie-qti/typeset-katex": "workspace:*",
    "@pie-qti/web-component-loaders": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-history": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/pm": "3.32.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "unzipper": "^0.12.3",
    "xml-formatter": "^3.7.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/unzipper": "^0.10.11",
    "@types/xml2js": "^0.4.14",
    "daisyui": "^5.7.50",
    "js-yaml": "^5.5.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "license": "MIT",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
