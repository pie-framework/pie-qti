{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		// `$app/tsconfig` sets `types`, so global types the tests rely on are listed here.
		"types": ["$app/types", "bun"],
		"strict": true,
		// Replaces the extended paths, so this lists the whole workspace alias map
		// (tsconfig.workspace-aliases.json; check-deps verifies the copy) before the item-player
		// entry points the demo runs from source. vite.config.ts reads its aliases from here.
		"paths": {
			"@pie-qti/assessment-player/components": ["../../packages/assessment-player/src/components/index.ts"],
			"@pie-qti/assessment-player/components/*": ["../../packages/assessment-player/src/components/*"],
			"@pie-qti/default-components/shared/components": [
				"../../packages/default-components/src/shared/components/index.ts"
			],
			"@pie-qti/i18n/components": ["../../packages/i18n/src/components/index.ts"],
			"@pie-qti/item-player/components": ["../../packages/item-player/src/components/index.ts"],
			"@pie-qti/section-player/components": ["../../packages/section-player/src/components/index.ts"],
			"@pie-qti/section-player/components/*": ["../../packages/section-player/src/components/*"],
			"@pie-qti/item-player/security": ["../../packages/item-player/src/security/index.ts"],
			"@pie-qti/item-player/element": ["../../packages/item-player/src/element.ts"],
			"@pie-qti/item-player/web-components": ["../../packages/item-player/src/web-components/index.ts"],
			"@pie-qti/item-player/iframe": ["../../packages/item-player/src/iframe/index.ts"],
			"@pie-qti/item-player/server": ["../../packages/item-player/src/server.ts"],
			"@pie-qti/item-player/pci": ["../../packages/item-player/src/pci/index.ts"],
			"@pie-qti/item-player": ["../../packages/item-player/src/index.ts"]
		}
	},
	"exclude": [
		"tests/playwright/**/*"
	],
	"include": [
		"src",
		"vite.config.ts",
		"playwright.config.ts",
		"tests"
	]
}
