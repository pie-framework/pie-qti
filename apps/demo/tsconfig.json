{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		// `$app/tsconfig` sets `types`, so global types the tests rely on are listed here.
		"types": ["$app/types", "bun"],
		"strict": true
	},
	"exclude": [
		"tests/playwright/**/*"
	],
	"include": [
		"src",
		"vite.config.ts",
		"playwright.config.ts",
		"tests"
	]
}
