<?xml version="1.0" encoding="UTF-8"?>
<!-- The real Savvas shape: every mapEntry is mappedValue="0" and upperBound="0", while the actual key sits in correctResponse. An unsigned reading of the mapping would mark every listed choice correct. upperBound="0" is also not a usable weight. -->
<assessmentItem xmlns="http://www.imsglobal.org/xsd/imsqti_v2p2"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqti_v2p2 http://www.imsglobal.org/xsd/qti/qtiv2p2/imsqti_v2p2.xsd"
                identifier="cf-mapping-all-zero-001"
                title="All-zero mapping alongside a real correctResponse"
                adaptive="false"
                timeDependent="false">
  <responseDeclaration identifier="RESPONSE" cardinality="single" baseType="identifier">
    <correctResponse>
      <value>choiceB</value>
    </correctResponse>
    <mapping defaultValue="-0" lowerBound="0" upperBound="0">
      <mapEntry mapKey="choiceA" mappedValue="0"/>
      <mapEntry mapKey="choiceB" mappedValue="0"/>
      <mapEntry mapKey="choiceC" mappedValue="0"/>
      <mapEntry mapKey="choiceD" mappedValue="0"/>
    </mapping>
  </responseDeclaration>
  <itemBody>
    <p>Which process releases energy from glucose?</p>
    <choiceInteraction responseIdentifier="RESPONSE" maxChoices="1" shuffle="false">
      <simpleChoice identifier="choiceA">Photosynthesis</simpleChoice>
      <simpleChoice identifier="choiceB">Respiration</simpleChoice>
      <simpleChoice identifier="choiceC">Transpiration</simpleChoice>
      <simpleChoice identifier="choiceD">Germination</simpleChoice>
    </choiceInteraction>
  </itemBody>
</assessmentItem>
