<?xml version="1.0" encoding="UTF-8"?>
<!-- Both defects at once: the key comes only from the mapping, and the resulting count is what forces checkbox. Guards against deriving cardinality before the answer key is known. -->
<assessmentItem xmlns="http://www.imsglobal.org/xsd/imsqti_v2p2"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqti_v2p2 http://www.imsglobal.org/xsd/qti/qtiv2p2/imsqti_v2p2.xsd"
                identifier="cf-cardinality-mapping-001"
                title="Two mapping-derived answers, maxChoices absent"
                adaptive="false"
                timeDependent="false">
  <responseDeclaration identifier="RESPONSE" cardinality="multiple" baseType="identifier">
    <mapping defaultValue="0">
      <mapEntry mapKey="choiceA" mappedValue="1"/>
      <mapEntry mapKey="choiceC" mappedValue="1"/>
    </mapping>
  </responseDeclaration>
  <itemBody>
    <p>Which of the following are prime numbers?</p>
    <choiceInteraction responseIdentifier="RESPONSE" shuffle="false">
      <simpleChoice identifier="choiceA">2</simpleChoice>
      <simpleChoice identifier="choiceB">4</simpleChoice>
      <simpleChoice identifier="choiceC">3</simpleChoice>
      <simpleChoice identifier="choiceD">6</simpleChoice>
    </choiceInteraction>
  </itemBody>
</assessmentItem>
