{
	"extends": ["./tsconfig.json", "../../tsconfig.workspace-aliases.json"],
	"compilerOptions": {
		"declaration": true,
		"declarationMap": false,
		"rootDir": "..",
		"types": [
			"svelte"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"src/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.test.ts"
	]
}
