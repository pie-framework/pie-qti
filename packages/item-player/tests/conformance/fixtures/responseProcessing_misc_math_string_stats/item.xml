<?xml version="1.0" encoding="UTF-8"?>
<assessmentItem
	xmlns="http://www.imsglobal.org/xsd/imsqti_v2p2"
	identifier="misc-math-string-stats"
	title="Misc operators"
	adaptive="false"
	timeDependent="false">

	<outcomeDeclaration identifier="SUB" cardinality="single" baseType="boolean">
		<defaultValue><value>false</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="IDIV" cardinality="single" baseType="integer">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="MOD" cardinality="single" baseType="integer">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="POW" cardinality="single" baseType="float">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="MEAN" cardinality="single" baseType="float">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="SVAR" cardinality="single" baseType="float">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="SSD" cardinality="single" baseType="float">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="PVAR_MILLI" cardinality="single" baseType="float">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>
	<outcomeDeclaration identifier="PSD_MILLI" cardinality="single" baseType="float">
		<defaultValue><value>0</value></defaultValue>
	</outcomeDeclaration>

	<itemBody>
		<p>Conformance: misc operators.</p>
	</itemBody>

	<responseProcessing>
		<responseCondition>
			<responseElse>
				<setOutcomeValue identifier="SUB">
					<!-- QTI substring is a boolean containment test on two string operands. -->
					<substring>
						<baseValue baseType="string">ABCDE</baseValue>
						<baseValue baseType="string">BCD</baseValue>
					</substring>
				</setOutcomeValue>

				<setOutcomeValue identifier="IDIV">
					<integerDivide>
						<baseValue baseType="integer">7</baseValue>
						<baseValue baseType="integer">2</baseValue>
					</integerDivide>
				</setOutcomeValue>

				<!-- QTI has no <mod>: integer remainder is integerModulus. -->
				<setOutcomeValue identifier="MOD">
					<integerModulus>
						<baseValue baseType="integer">7</baseValue>
						<baseValue baseType="integer">2</baseValue>
					</integerModulus>
				</setOutcomeValue>

				<setOutcomeValue identifier="POW">
					<power>
						<baseValue baseType="integer">2</baseValue>
						<baseValue baseType="integer">3</baseValue>
					</power>
				</setOutcomeValue>

				<!-- Statistics are statsOperator name="..." (QTI has no mean/sampleVariance/... elements). -->
				<setOutcomeValue identifier="MEAN">
					<statsOperator name="mean">
						<multiple>
							<baseValue baseType="integer">1</baseValue>
							<baseValue baseType="integer">2</baseValue>
							<baseValue baseType="integer">3</baseValue>
						</multiple>
					</statsOperator>
				</setOutcomeValue>

				<setOutcomeValue identifier="SVAR">
					<statsOperator name="sampleVariance">
						<multiple>
							<baseValue baseType="integer">1</baseValue>
							<baseValue baseType="integer">2</baseValue>
							<baseValue baseType="integer">3</baseValue>
						</multiple>
					</statsOperator>
				</setOutcomeValue>

				<setOutcomeValue identifier="SSD">
					<statsOperator name="sampleSD">
						<multiple>
							<baseValue baseType="integer">1</baseValue>
							<baseValue baseType="integer">2</baseValue>
							<baseValue baseType="integer">3</baseValue>
						</multiple>
					</statsOperator>
				</setOutcomeValue>

				<setOutcomeValue identifier="PVAR_MILLI">
					<truncate>
						<product>
							<statsOperator name="popVariance">
								<multiple>
									<baseValue baseType="integer">1</baseValue>
									<baseValue baseType="integer">2</baseValue>
									<baseValue baseType="integer">3</baseValue>
								</multiple>
							</statsOperator>
							<baseValue baseType="float">1000</baseValue>
						</product>
					</truncate>
				</setOutcomeValue>

				<setOutcomeValue identifier="PSD_MILLI">
					<truncate>
						<product>
							<statsOperator name="popSD">
								<multiple>
									<baseValue baseType="integer">1</baseValue>
									<baseValue baseType="integer">2</baseValue>
									<baseValue baseType="integer">3</baseValue>
								</multiple>
							</statsOperator>
							<baseValue baseType="float">1000</baseValue>
						</product>
					</truncate>
				</setOutcomeValue>
			</responseElse>
		</responseCondition>
	</responseProcessing>
</assessmentItem>


