<?xml version="1.0" encoding="UTF-8"?>
<assessmentItem
  xmlns="http://www.imsglobal.org/xsd/imsqti_v2p2"
  identifier="responseProcessing_record_fieldValue"
  title="record + fieldValue"
  adaptive="false"
  timeDependent="false"
>
  <!-- Records are a declaration cardinality: the record value arrives with the session
       (host-delivered), and fieldValue reads its fields. No QTI version defines an authored
       record constructor. -->
  <responseDeclaration identifier="REC" cardinality="record"/>

  <outcomeDeclaration identifier="OUT_X" cardinality="single" baseType="integer">
    <defaultValue><value>0</value></defaultValue>
  </outcomeDeclaration>
  <outcomeDeclaration identifier="OUT_Y" cardinality="single" baseType="string">
    <defaultValue><value></value></defaultValue>
  </outcomeDeclaration>

  <itemBody>
    <p>Record fixture</p>
  </itemBody>

  <responseProcessing>
    <setOutcomeValue identifier="OUT_X">
      <fieldValue fieldIdentifier="x">
        <variable identifier="REC"/>
      </fieldValue>
    </setOutcomeValue>
    <setOutcomeValue identifier="OUT_Y">
      <fieldValue fieldIdentifier="y">
        <variable identifier="REC"/>
      </fieldValue>
    </setOutcomeValue>
  </responseProcessing>
</assessmentItem>
